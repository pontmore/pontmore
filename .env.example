# Local Docker settings only. just docker-up copies this file to .env on first run.
POSTGRES_DB=pontmore
POSTGRES_USER=pontmore
POSTGRES_PASSWORD=pontmore-development-only
PONTMORE_DATABASE_URL=postgres://pontmore:pontmore-development-only@postgres/pontmore
PONTMORE_LISTEN=0.0.0.0:7300
PONTMORE_UI_LISTEN=0.0.0.0:7301
PONTMORE_UI_PASSWORD_FILE=/run/pontmore/ui-password
PONTMORE_UI_SECURE_COOKIES=true
PONTMORE_CLIENT_PORT=7300
PONTMORE_UI_PORT=7301
RUST_LOG=pontmored=info,tower_http=info
